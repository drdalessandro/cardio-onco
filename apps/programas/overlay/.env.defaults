# Programas — app del paciente · Cardio-Oncología Marie Curie
#
# FooMedical 5.1.27 lee todo esto por `import.meta.env` (envPrefix en
# vite.config.ts). No hay nada hardcodeado: apuntar a otro servidor o a otro
# Project es cambiar estas variables, no editar código.

# ── Servidor FHIR: Favaloro | Medplum Argentina ──
MEDPLUM_BASE_URL="https://api.medplum.com.ar"

# ── Project ──
# DEBE ser el MISMO Project donde corre cardio-onco (la app de los clínicos).
# Los recursos NO se comparten entre Projects: si el paciente carga sus datos en
# otro Project, el equipo clínico nunca los ve.
MEDPLUM_PROJECT_ID=

# ClientApplication del Project, para el registro y el login del paciente.
MEDPLUM_CLIENT_ID=

# ── Registro de pacientes ──
# El registro abierto exige que `cardio-onco-patient` esté marcada como
# *default patient access policy* del Project. Ver docs/access-policies.md del
# repo cardio-onco: sin eso, un paciente nuevo entra sin restricciones.
RECAPTCHA_SITE_KEY=

# ── Google OAuth (opcional) ──
GOOGLE_CLIENT_ID=
