{
  "mcpServers": {
    "cardio-onco-research": {
      "command": "npx",
      "args": ["tsx", "src/research/mcp-server.ts"],
      "env": {
        "MEDPLUM_BASE_URL": "https://api.medplum.com.ar",
        "MEDPLUM_CLIENT_ID": "${MEDPLUM_RESEARCH_CLIENT_ID}",
        "MEDPLUM_CLIENT_SECRET": "${MEDPLUM_RESEARCH_CLIENT_SECRET}"
      }
    }
  }
}
