# Plantilla de configuración — Cardio-Oncología Marie Curie
#
# `vite.config.ts` copia este archivo a `.env` si no existe. `.env` NO se versiona
# (lleva credenciales): editalo localmente o inyectá las variables por entorno.

# ── Servidor FHIR del proyecto: Favaloro | Medplum Argentina ──
MEDPLUM_BASE_URL="https://api.medplum.com.ar"

# ── ClientApplication del Project destino ──
# El Project al que pertenece este client DETERMINA dónde se instalan los datos:
# bootstrap y migración escriben ahí. Crealo dentro del Project de Cardio-Onco.
MEDPLUM_CLIENT_ID=
# Sólo lo usan los scripts de Node (bootstrap y migrador). Nunca lo commitees.
MEDPLUM_CLIENT_SECRET=

# ── Google OAuth (opcional, si está habilitado el login con Google) ──
GOOGLE_CLIENT_ID=

# ── Servidor de desarrollo local ──
# MEDPLUM_BASE_URL="http://localhost:8103"
# GOOGLE_CLIENT_ID="397236612778-c0b5tnjv98frbo1tfuuha5vkme3cmq4s.apps.googleusercontent.com"
